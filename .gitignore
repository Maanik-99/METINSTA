# ==============================================================================
# Git Ignore - METINSTA
# ==============================================================================

# Local / Private Backups & Overrides
*.local.*
*.private.*
*.real.*
*.backup.*

# Telegram Session Files
*.session
*.session-journal
taskly_*.session*

# Large Assets / Image Verification Photos
images/
images/*

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o
*.lib

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Local Settings
.env
.env.*

# Logs and databases
*.log
*.sqlite
*.sqlite3
*.db

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE / Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
